msgstr "Свободни часове на %s"

msgid "Tap a time to move your appointment. You will receive a confirmation by email."
msgstr "Докоснете час, за да преместите Вашия час. Ще получите потвърждение по имейл."

msgid "Not possible"
msgstr "Не е възможно"

msgid "This appointment can no longer be cancelled online. Please contact us directly."
msgstr "Този час вече не може да бъде отменен онлайн. Моля, свържете се директно с нас."

msgid "Reason given by the customer:"
msgstr "Причина, посочена от клиента:"

