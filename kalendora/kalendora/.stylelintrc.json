{
	"extends": "@wordpress/stylelint-config/scss",
	"rules": {
		"no-descending-specificity": null,
		"selector-class-pattern": [
			"^[a-z0-9]+(-[a-z0-9]+)*(__[a-z0-9]+(-[a-z0-9]+)*)?(--[a-z0-9]+(-[a-z0-9]+)*)?$",
			{ "message": "Use lowercase BEM class names (block__element--modifier)." }
		]
	}
}
