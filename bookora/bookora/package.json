{
  "name": "bookora",
  "version": "0.1.0",
  "private": true,
  "description": "Bookora – Appointments & Booking Forms by Marinov Solutions",
  "license": "GPL-2.0-or-later",
  "scripts": {
    "build": "npm run build:admin && npm run build:frontend",
    "start": "wp-scripts start assets/admin/src/index.js --output-path=build/admin",
    "lint:js": "wp-scripts lint-js assets",
    "lint:css": "wp-scripts lint-style \"assets/**/*.scss\"",
    "test:js": "wp-scripts test-unit-js --passWithNoTests",
    "plugin-zip": "wp-scripts plugin-zip",
    "build:admin": "wp-scripts build assets/admin/src/index.js --output-path=build/admin",
    "build:frontend": "wp-scripts build assets/frontend/src/index.js --output-path=build/frontend",
    "start:frontend": "wp-scripts start assets/frontend/src/index.js --output-path=build/frontend",
    "i18n": "python3 tools/i18n-build.py"
  },
  "files": [
    "bookora.php",
    "uninstall.php",
    "readme.txt",
    "src",
    "build",
    "languages"
  ],
  "devDependencies": {
    "@wordpress/scripts": "^30.0.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2"
  }
}
