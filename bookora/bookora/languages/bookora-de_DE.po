msgid "We have received your booking request"
msgstr "Wir haben Ihre Buchungsanfrage erhalten"

msgid "Hello {customer_name},\n\nthank you for your request. We have received the following booking:\n\n<strong>{service}</strong>\n{date}, {time} – {end_time}\n\nWe will check the appointment and confirm it shortly by email.\n\nKind regards\n{business_name}"
msgstr "Hallo {customer_name},\n\nvielen Dank für Ihre Anfrage. Wir haben folgende Buchung erhalten:\n\n<strong>{service}</strong>\n{date}, {time} – {end_time} Uhr\n\nWir prüfen den Termin und bestätigen ihn in Kürze per E-Mail.\n\nViele Grüße\n{business_name}"

msgid "Your appointment on {date} is confirmed"
msgstr "Ihr Termin am {date} ist bestätigt"

msgid "Hello {customer_name},\n\nyour appointment is confirmed:\n\n<strong>{service}</strong>\n{date}, {time} – {end_time}\n{staff}\n\n{calendar_button}\n\nIf you cannot make it, please let us know in good time.\n\nWe look forward to seeing you!\n{business_name}"
msgstr "Hallo {customer_name},\n\nIhr Termin ist bestätigt:\n\n<strong>{service}</strong>\n{date}, {time} – {end_time} Uhr\n{staff}\n\n{calendar_button}\n\nFalls Sie verhindert sind, sagen Sie bitte rechtzeitig Bescheid.\n\nWir freuen uns auf Sie!\n{business_name}"

msgid "Your booking request for {date}"
msgstr "Ihre Buchungsanfrage für {date}"

msgid "Hello {customer_name},\n\nunfortunately we cannot offer you the requested appointment ({service}, {date} at {time}).\n\nPlease choose another time on our website: {site_url}\n\nKind regards\n{business_name}"
msgstr "Hallo {customer_name},\n\nleider können wir Ihnen den gewünschten Termin ({service}, {date} um {time} Uhr) nicht anbieten.\n\nBitte wählen Sie auf unserer Webseite eine andere Zeit: {site_url}\n\nViele Grüße\n{business_name}"

msgid "Your appointment on {date} has been cancelled"
msgstr "Ihr Termin am {date} wurde storniert"

msgid "Hello {customer_name},\n\nyour appointment has been cancelled:\n\n{service}\n{date}, {time}\n\nYou are welcome to book a new appointment at any time: {site_url}\n\nKind regards\n{business_name}"
msgstr "Hallo {customer_name},\n\nIhr Termin wurde storniert:\n\n{service}\n{date}, {time} Uhr\n\nSie können jederzeit gerne einen neuen Termin buchen: {site_url}\n\nViele Grüße\n{business_name}"

msgid "Reminder: your appointment on {date} at {time}"
msgstr "Erinnerung: Ihr Termin am {date} um {time} Uhr"

msgid "Hello {customer_name},\n\nwe would like to remind you of your appointment:\n\n<strong>{service}</strong>\n{date}, {time} – {end_time}\n\n{calendar_button}\n\nIf you cannot make it, please let us know as soon as possible.\n\nSee you soon!\n{business_name}"
msgstr "Hallo {customer_name},\n\nwir möchten Sie an Ihren Termin erinnern:\n\n<strong>{service}</strong>\n{date}, {time} – {end_time} Uhr\n\n{calendar_button}\n\nFalls Sie verhindert sind, sagen Sie bitte so früh wie möglich Bescheid.\n\nBis bald!\n{business_name}"

msgid "New booking: {service} on {date} at {time}"
msgstr "Neue Buchung: {service} am {date} um {time} Uhr"

msgid "New booking from <strong>{customer_name}</strong>\n\n{service}\n{date}, {time} – {end_time}\n{staff}\n\nEmail: {customer_email}\nPhone: {customer_phone}\n\n{all_fields}\n\n{action_buttons}"
msgstr "Neue Buchung von <strong>{customer_name}</strong>\n\n{service}\n{date}, {time} – {end_time} Uhr\n{staff}\n\nE-Mail: {customer_email}\nTelefon: {customer_phone}\n\n{all_fields}\n\n{action_buttons}"

msgid "Thank you for your message"
msgstr "Vielen Dank für Ihre Nachricht"

msgid "Hello {customer_name},\n\nthank you for your message. We will get back to you as soon as possible.\n\nKind regards\n{business_name}"
msgstr "Hallo {customer_name},\n\nvielen Dank für Ihre Nachricht. Wir melden uns so schnell wie möglich bei Ihnen.\n\nViele Grüße\n{business_name}"

msgid "New message via {form_title}"
msgstr "Neue Nachricht über {form_title}"

msgid "New message from <strong>{customer_name}</strong> ({customer_email})\n\n{all_fields}\n\n{admin_link}"
msgstr "Neue Nachricht von <strong>{customer_name}</strong> ({customer_email})\n\n{all_fields}\n\n{admin_link}"

